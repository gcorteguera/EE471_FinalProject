# ============================================================
# PLOT 4: STANLEY GAIN SWEEP
# ============================================================

def plot_stanley_gain_sweep():
    """
    Plot mean and max cross-track error for Stanley gain values.
    """

    for route in ROUTES:
        gains = []
        mean_errors = []
        max_errors = []

        for k in STANLEY_GAINS:
            label = str(k).replace(".", "")
            filename = f"stanley_{route}_k{label}.csv"

            df = load_csv(filename)

            if df is None:
                continue

            gains.append(k)
            mean_errors.append(df["cross_track_error"].abs().mean())
            max_errors.append(df["cross_track_error"].abs().max())

        if not gains:
            continue

        plt.figure()

        plt.plot(gains, mean_errors, marker="o", label="Mean |CTE|")
        plt.plot(gains, max_errors, marker="o", label="Max |CTE|")

        plt.xlabel("Stanley Gain k")
        plt.ylabel("Cross-Track Error [m]")
        plt.title(f"Stanley Gain Sweep - {route}")
        plt.grid(True)
        plt.legend()

        save_plot(f"stanley_gain_sweep_{route}.png")


# ============================================================
# PLOT 5: PURE PURSUIT LOOKAHEAD SWEEP
# ============================================================

def plot_pure_pursuit_lookahead_sweep():
    """
    Plot mean and max cross-track error for Pure Pursuit lookahead values.
    """

    for route in ROUTES:
        lookaheads = []
        mean_errors = []
        max_errors = []

        for ld in PURE_PURSUIT_LOOKAHEADS:
            filename = f"purepursuit_{route}_ld{ld}.csv"

            df = load_csv(filename)

            if df is None:
                continue

            lookaheads.append(ld)
            mean_errors.append(df["cross_track_error"].abs().mean())
            max_errors.append(df["cross_track_error"].abs().max())

        if not lookaheads:
            continue

        plt.figure()

        plt.plot(lookaheads, mean_errors, marker="o", label="Mean |CTE|")
        plt.plot(lookaheads, max_errors, marker="o", label="Max |CTE|")

        plt.xlabel("Lookahead Distance [m]")
        plt.ylabel("Cross-Track Error [m]")
        plt.title(f"Pure Pursuit Lookahead Sweep - {route}")
        plt.grid(True)
        plt.legend()

        save_plot(f"purepursuit_lookahead_sweep_{route}.png")


# ============================================================
# SUMMARY TABLE
# ============================================================

def create_summary_table():
    """
    Create a summary table from all valid CSV files.

    The table includes:
        - mean cross-track error
        - max cross-track error
        - mean heading error
        - max heading error
        - final distance to goal
        - simulation time
    """

    rows = []

    csv_files = glob.glob(os.path.join(RESULTS_FOLDER, "*.csv"))

    for file_path in csv_files:
        filename = os.path.basename(file_path)

        df = pd.read_csv(file_path)

        if not is_valid_dataframe(df):
            print(f"Skipping old/incompatible file: {filename}")
            continue

        rows.append({
            "file": filename,
            "route": df["route_name"].iloc[0],
            "controller": df["controller_type"].iloc[0],
            "tuning_value": df["tuning_value"].iloc[0],
            "mean_abs_cte_m": df["cross_track_error"].abs().mean(),
            "max_abs_cte_m": df["cross_track_error"].abs().max(),
            "mean_abs_heading_error_deg": df["heading_error_deg"].abs().mean(),
            "max_abs_heading_error_deg": df["heading_error_deg"].abs().max(),
            "final_distance_to_goal_m": df["distance_to_goal"].iloc[-1],
            "simulation_time_s": df["time"].iloc[-1]
        })

    summary = pd.DataFrame(rows)

    if not summary.empty:
        summary = summary.sort_values(
            by=["route", "controller", "tuning_value"]
        )

    summary_path = os.path.join(PLOTS_FOLDER, "summary_metrics.csv")
    summary.to_csv(summary_path, index=False)

    print(f"Saved summary table: {summary_path}")


# ============================================================
# MAIN
# ============================================================

def main():
    make_plots_folder()

    plot_representative_trajectories()
    plot_cross_track_error()
    plot_heading_error()
    plot_stanley_gain_sweep()
    plot_pure_pursuit_lookahead_sweep()
    create_summary_table()

    print("\nAll plots complete.")
    print(f"Plots saved in folder: {PLOTS_FOLDER}")


if __name__ == "__main__":
    main()