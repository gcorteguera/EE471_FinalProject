import os
import glob
import pandas as pd
import matplotlib.pyplot as plt


# ============================================================
# SETTINGS
# ============================================================

RESULTS_FOLDER = "results"
PLOTS_FOLDER = "plots"

ROUTES = ["straightline", "ccurve", "sturn"]

STANLEY_GAINS = [0.4, 0.8, 1.2]
PURE_PURSUIT_LOOKAHEADS = [3, 6, 10]

REQUIRED_COLUMNS = [
    "route_name",
    "controller_type",
    "tuning_value",
    "time",
    "x",
    "y",
    "path_x",
    "path_y",
    "cross_track_error",
    "heading_error_deg",
    "distance_to_goal"
]


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def make_plots_folder():
    """Create plots folder if it does not already exist."""
    os.makedirs(PLOTS_FOLDER, exist_ok=True)


def is_valid_dataframe(df):
    """
    Check whether a CSV file contains the columns required
    for the newest plotting script.
    """

    for col in REQUIRED_COLUMNS:
        if col not in df.columns:
            return False

    return not df.empty


def load_csv(filename):
    """
    Load one CSV file from the results folder.

    If the file is missing or from an older script version, skip it.
    """

    path = os.path.join(RESULTS_FOLDER, filename)

    if not os.path.exists(path):
        print(f"Missing file: {path}")
        return None

    df = pd.read_csv(path)

    if not is_valid_dataframe(df):
        print(f"Skipping incompatible file: {filename}")
        return None

    return df


def save_plot(filename):
    """Save the current plot to the plots folder."""

    path = os.path.join(PLOTS_FOLDER, filename)
    plt.tight_layout()
    plt.savefig(path, dpi=300)
    plt.close()

    print(f"Saved plot: {path}")


# ============================================================
# PLOT 1: TRAJECTORY VS REFERENCE PATH
# ============================================================

def plot_representative_trajectories():
    """
    Plot the reference path and overlay both controller trajectories.

    Representative tuning values:
        Stanley: k = 0.8
        Pure Pursuit: lookahead = 6 m
    """

    for route in ROUTES:
        stanley_file = f"stanley_{route}_k08.csv"
        pp_file = f"purepursuit_{route}_ld6.csv"

        stanley = load_csv(stanley_file)
        pp = load_csv(pp_file)

        if stanley is None or pp is None:
            continue

        plt.figure()

        # Reference path.
        #
        # The reference path is reconstructed from the logged closest
        # waypoint positions.
        plt.plot(
            stanley["path_x"],
            stanley["path_y"],
            linestyle="--",
            linewidth=2,
            label="Reference Path"
        )

        # Stanley vehicle trajectory.
        plt.plot(
            stanley["x"],
            stanley["y"],
            label="Stanley k=0.8"
        )

        # Pure Pursuit vehicle trajectory.
        plt.plot(
            pp["x"],
            pp["y"],
            label="Pure Pursuit Ld=6m"
        )

        plt.xlabel("X Position [m]")
        plt.ylabel("Y Position [m]")
        plt.title(f"Trajectory vs Reference Path - {route}")
        plt.axis("equal")
        plt.grid(True)
        plt.legend()

        save_plot(f"trajectory_reference_{route}.png")


# ============================================================
# PLOT 2: CROSS-TRACK ERROR COMPARISON
# ============================================================

def plot_cross_track_error():
    """
    Compare cross-track error over time for representative tuning.
    """

    for route in ROUTES:
        stanley_file = f"stanley_{route}_k08.csv"
        pp_file = f"purepursuit_{route}_ld6.csv"

        stanley = load_csv(stanley_file)
        pp = load_csv(pp_file)

        if stanley is None or pp is None:
            continue

        plt.figure()

        plt.plot(
            stanley["time"],
            stanley["cross_track_error"].abs(),
            label="Stanley k=0.8"
        )

        plt.plot(
            pp["time"],
            pp["cross_track_error"].abs(),
            label="Pure Pursuit Ld=6m"
        )

        plt.xlabel("Time [s]")
        plt.ylabel("Absolute Cross-Track Error [m]")
        plt.title(f"Cross-Track Error - {route}")
        plt.grid(True)
        plt.legend()

        save_plot(f"cross_track_error_{route}.png")


