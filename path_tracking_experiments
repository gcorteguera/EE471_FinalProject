import carla
import math
import csv
import os
import time

# ============================================================
# PROJECT:
#   Pure Pursuit vs. Stanley Path Tracking in CARLA
#
# IMPORTANT:
#   All paths now use CARLA road waypoints.
#
#   This prevents the red path from cutting through rocks,
#   buildings, walls, or other obstacles.
#
# ROUTES:
#   The script automatically searches the map for:
#
#       1. straightline  -> least heading change
#       2. ccurve        -> mostly one-direction turning
#       3. sturn         -> left and right turning
#
# ============================================================


# ============================================================
# GLOBAL SETTINGS
# ============================================================

MAP_NAME = "Town04"
RESULTS_FOLDER = "results"
TARGET_SPEED = 6.0
NUM_PATH_POINTS = 300
POINT_SPACING = 2.0
MAX_STEPS = 4000
FIXED_DELTA_SECONDS = 0.05
GOAL_DISTANCE_THRESHOLD = 5.0
CAMERA_HEIGHT = 80


# ============================================================
# ROUTES
# ============================================================

ROUTES = [
    {
        "name": "straightline",
        "spawn_index": "auto_straight"
    },
    {
        "name": "ccurve",
        "spawn_index": "auto_ccurve"
    },
    {
        "name": "sturn",
        "spawn_index": "auto_sturn"
    }
]


# ============================================================
# TUNING PARAMETER SWEEPS
# ============================================================

STANLEY_GAINS = [0.4, 0.8, 1.2]

PURE_PURSUIT_LOOKAHEADS = [3.0, 6.0, 10.0]


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def normalize_angle(angle):
    """Normalize angle to [-pi, pi]."""
    while angle > math.pi:
        angle -= 2.0 * math.pi

    while angle < -math.pi:
        angle += 2.0 * math.pi

    return angle


def angle_diff_deg(a, b):
    """
    Compute shortest signed difference between two angles in degrees.
    """
    diff = a - b

    while diff > 180:
        diff -= 360

    while diff < -180:
        diff += 360

    return diff


def get_speed(vehicle):
    """Compute vehicle speed in m/s."""
    v = vehicle.get_velocity()
    return math.sqrt(v.x**2 + v.y**2 + v.z**2)


def distance_2d(loc1, loc2):
    """Compute distance between two CARLA locations using x-y only."""
    return math.sqrt((loc1.x - loc2.x)**2 + (loc1.y - loc2.y)**2)


def clamp(value, low, high):
    """Limit a value between low and high."""
    return max(low, min(high, value))


def format_gain(value):
    """
    Convert tuning value to filename-safe label.

    Examples:
        0.4 -> 04
        0.8 -> 08
        1.2 -> 12
    """
    return str(value).replace(".", "")


# ============================================================
# ROAD PATH GENERATION
# ============================================================

def generate_road_path(carla_map, spawn_transform):
    """
    Generate a reference path using CARLA's road waypoints.

    This keeps the red path on the drivable road network.
    """

    waypoint = carla_map.get_waypoint(spawn_transform.location)
    path = []

    for _ in range(NUM_PATH_POINTS):
        path.append(waypoint.transform)

        next_waypoints = waypoint.next(POINT_SPACING)

        if not next_waypoints:
            break

        waypoint = next_waypoints[0]

    return path


# ============================================================
# ROUTE SHAPE ANALYSIS
# ============================================================

def analyze_path_shape(path):
    """
    Analyze the shape of a road path using heading changes.

    Returns:
        total_abs_change:
            total amount of turning

        net_change:
            final turning direction

        positive_turn_count:
            number of left-turning increments

        negative_turn_count:
            number of right-turning increments

        direction_changes:
            number of times the path changes turning direction
    """

    headings = [tf.rotation.yaw for tf in path]

    heading_changes = []

    for i in range(1, len(headings)):
        change = angle_diff_deg(headings[i], headings[i - 1])
        heading_changes.append(change)

    total_abs_change = sum(abs(change) for change in heading_changes)
    net_change = sum(heading_changes)

    positive_turn_count = sum(1 for change in heading_changes if change > 0.5)
    negative_turn_count = sum(1 for change in heading_changes if change < -0.5)

    direction_changes = 0
    previous_sign = 0

    for change in heading_changes:
        if abs(change) < 0.5:
            continue

        current_sign = 1 if change > 0 else -1

        if previous_sign != 0 and current_sign != previous_sign:
            direction_changes += 1

        previous_sign = current_sign

    return {
        "total_abs_change": total_abs_change,
        "net_change": net_change,
        "positive_turn_count": positive_turn_count,
        "negative_turn_count": negative_turn_count,
        "direction_changes": direction_changes
    }


def find_best_straight_route(carla_map):
    """
    Find the spawn point with the straightest road path.

    Straight path criterion:
        smallest total absolute heading change
    """

    spawn_points = carla_map.get_spawn_points()

    best_spawn_index = 0
    best_score = float("inf")

    for spawn_index, spawn in enumerate(spawn_points):
        path = generate_road_path(carla_map, spawn)
        shape = analyze_path_shape(path)

        score = shape["total_abs_change"]

        if score < best_score:
            best_score = score
            best_spawn_index = spawn_index

    print(f"Best straightline route: spawn {best_spawn_index}, score {best_score:.2f}")

    return best_spawn_index


def find_best_ccurve_route(carla_map):
    """
    Find a good C-curve road path.

    C-curve criterion:
        - large total turning
        - mostly one direction
        - few direction changes
    """

    spawn_points = carla_map.get_spawn_points()

    best_spawn_index = 0
    best_score = -float("inf")

    for spawn_index, spawn in enumerate(spawn_points):
        path = generate_road_path(carla_map, spawn)
        shape = analyze_path_shape(path)

        total_abs = shape["total_abs_change"]
        net = abs(shape["net_change"])
        direction_changes = shape["direction_changes"]

        # Reward strong one-direction turning.
        # Penalize many direction changes.
        score = net + 0.4 * total_abs - 20.0 * direction_changes

        if total_abs > 30 and direction_changes <= 2 and score > best_score:
            best_score = score
            best_spawn_index = spawn_index

    print(f"Best ccurve route: spawn {best_spawn_index}, score {best_score:.2f}")

    return best_spawn_index


def find_best_sturn_route(carla_map):
    """
    Find a good S-turn road path.

    S-turn criterion:
        - path has both left and right turns
        - path changes turning direction
        - enough total heading change to be interesting
    """

    spawn_points = carla_map.get_spawn_points()

    best_spawn_index = 0
    best_score = -float("inf")

    for spawn_index, spawn in enumerate(spawn_points):
        path = generate_road_path(carla_map, spawn)
        shape = analyze_path_shape(path)

        total_abs = shape["total_abs_change"]
        pos = shape["positive_turn_count"]
        neg = shape["negative_turn_count"]
        direction_changes = shape["direction_changes"]

        if pos > 5 and neg > 5 and direction_changes >= 1:
            # Reward both turning directions and total curvature.
            score = total_abs + 30.0 * direction_changes + min(pos, neg)

            if score > best_score:
                best_score = score
                best_spawn_index = spawn_index

    print(f"Best sturn route: spawn {best_spawn_index}, score {best_score:.2f}")

    return best_spawn_index


def resolve_spawn_index(carla_map, spawn_setting):
    """
    Convert route spawn setting into an actual spawn index.
    """

    if spawn_setting == "auto_straight":
        return find_best_straight_route(carla_map)

    if spawn_setting == "auto_ccurve":
        return find_best_ccurve_route(carla_map)

    if spawn_setting == "auto_sturn":
        return find_best_sturn_route(carla_map)

    return spawn_setting


# ============================================================
# CONTROLLERS
# ============================================================

def stanley_control(vehicle, path, k):
    """
    Stanley controller.

    Uses:
        heading error
        cross-track error
    """

    transform = vehicle.get_transform()
    loc = transform.location
    yaw = math.radians(transform.rotation.yaw)

    closest_idx = 0
    min_dist = float("inf")

    for i, path_tf in enumerate(path):
        dist = distance_2d(loc, path_tf.location)

        if dist < min_dist:
            min_dist = dist
            closest_idx = i

    closest_tf = path[closest_idx]
    path_yaw = math.radians(closest_tf.rotation.yaw)

    heading_error = normalize_angle(path_yaw - yaw)

    dx = loc.x - closest_tf.location.x
    dy = loc.y - closest_tf.location.y

    perp_heading = path_yaw + math.pi / 2.0

    cross_track_error = (
        dx * math.cos(perp_heading)
        + dy * math.sin(perp_heading)
    )

    speed = max(get_speed(vehicle), 0.1)

    steer_rad = heading_error - math.atan2(k * cross_track_error, speed)

    steer = steer_rad / math.radians(35.0)
    steer = clamp(steer, -1.0, 1.0)

    return steer, cross_track_error, heading_error, closest_idx


def pure_pursuit_control(vehicle, path, lookahead_distance, wheelbase=2.8):
    """
    Pure Pursuit controller.

    Uses a target point ahead of the vehicle.
    """

    transform = vehicle.get_transform()
    loc = transform.location
    yaw = math.radians(transform.rotation.yaw)

    closest_idx = 0
    min_dist = float("inf")

    for i, path_tf in enumerate(path):
        dist = distance_2d(loc, path_tf.location)

        if dist < min_dist:
            min_dist = dist
            closest_idx = i

    target_idx = closest_idx

    for i in range(closest_idx, len(path)):
        if distance_2d(loc, path[i].location) >= lookahead_distance:
            target_idx = i
            break

    target_tf = path[target_idx]
    target_loc = target_tf.location

    dx = target_loc.x - loc.x
    dy = target_loc.y - loc.y

    target_angle = math.atan2(dy, dx)
    alpha = normalize_angle(target_angle - yaw)

    steer_rad = math.atan2(
        2.0 * wheelbase * math.sin(alpha),
        lookahead_distance
    )

    steer = steer_rad / math.radians(35.0)
    steer = clamp(steer, -1.0, 1.0)

    heading_error = normalize_angle(
        math.radians(path[closest_idx].rotation.yaw) - yaw
    )

    cross_track_error = min_dist

    return steer, cross_track_error, heading_error, closest_idx, target_idx


# ============================================================
# SPEED CONTROL
# ============================================================

def speed_control(vehicle, target_speed):
    """
    Basic speed controller.
    """

    speed = get_speed(vehicle)

    if speed < target_speed:
        throttle = 0.35
        brake = 0.0

    elif speed < target_speed + 1.0:
        throttle = 0.15
        brake = 0.0

    else:
        throttle = 0.0
        brake = 0.2

    return throttle, brake


# ============================================================
# OUTPUT FILE NAMING
# ============================================================

def make_output_filename(controller_type, route_name, tuning_value):
    """
    Create clear CSV file names.
    """

    if controller_type == "stanley":
        return f"stanley_{route_name}_k{format_gain(tuning_value)}.csv"

    if controller_type == "pure_pursuit":
        return f"purepursuit_{route_name}_ld{int(tuning_value)}.csv"

    raise ValueError("Invalid controller type.")


# ============================================================
# SINGLE EXPERIMENT
# ============================================================

def run_single_experiment(
    world,
    carla_map,
    blueprint_library,
    route_name,
    spawn_index,
    controller_type,
    tuning_value
):
    vehicle = None

    spawn_points = carla_map.get_spawn_points()

    if spawn_index >= len(spawn_points):
        raise ValueError(
            f"Spawn index {spawn_index} is too large. "
            f"This map has only {len(spawn_points)} spawn points."
        )

    spawn = spawn_points[spawn_index]

    output_filename = make_output_filename(
        controller_type,
        route_name,
        tuning_value
    )

    output_path = os.path.join(RESULTS_FOLDER, output_filename)

    print("\n============================================================")
    print("Starting experiment")
    print(f"Route: {route_name}")
    print(f"Spawn index: {spawn_index}")
    print(f"Controller: {controller_type}")
    print(f"Tuning value: {tuning_value}")
    print(f"Output: {output_path}")
    print("============================================================")

    try:
        vehicle_bp = blueprint_library.find("vehicle.tesla.model3")
        vehicle = world.spawn_actor(vehicle_bp, spawn)

        world.tick()

        spectator = world.get_spectator()

        path = generate_road_path(carla_map, spawn)
        goal_location = path[-1].location

        for path_tf in path:
            world.debug.draw_point(
                path_tf.location + carla.Location(z=0.5),
                size=0.12,
                color=carla.Color(255, 0, 0),
                life_time=120.0
            )

        world.debug.draw_point(
            goal_location + carla.Location(z=1.0),
            size=0.6,
            color=carla.Color(255, 255, 0),
            life_time=120.0
        )

        log = []

        for step in range(MAX_STEPS):
            world.tick()

            if controller_type == "stanley":
                steer, cte, heading_error, closest_idx = stanley_control(
                    vehicle,
                    path,
                    tuning_value
                )

                target_idx = -1

            elif controller_type == "pure_pursuit":
                steer, cte, heading_error, closest_idx, target_idx = pure_pursuit_control(
                    vehicle,
                    path,
                    tuning_value
                )

                if target_idx >= 0:
                    world.debug.draw_point(
                        path[target_idx].location + carla.Location(z=1.0),
                        size=0.25,
                        color=carla.Color(0, 255, 0),
                        life_time=0.1
                    )

            else:
                raise ValueError("Invalid controller type.")

            throttle, brake = speed_control(vehicle, TARGET_SPEED)

            vehicle.apply_control(
                carla.VehicleControl(
                    throttle=throttle,
                    steer=steer,
                    brake=brake
                )
            )

            transform = vehicle.get_transform()
            speed = get_speed(vehicle)
            distance_to_goal = distance_2d(
                transform.location,
                goal_location
            )

            spectator.set_transform(
                carla.Transform(
                    transform.location + carla.Location(z=CAMERA_HEIGHT),
                    carla.Rotation(
                        pitch=-90,
                        yaw=0,
                        roll=0
                    )
                )
            )

            log.append([
                step,
                step * FIXED_DELTA_SECONDS,
                route_name,
                spawn_index,
                controller_type,
                tuning_value,
                transform.location.x,
                transform.location.y,
                transform.rotation.yaw,
                steer,
                throttle,
                brake,
                cte,
                math.degrees(heading_error),
                closest_idx,
                target_idx,
                speed,
                distance_to_goal
            ])

            if closest_idx > len(path) - 10 and distance_to_goal < GOAL_DISTANCE_THRESHOLD:
                print("Goal reached.")
                break

        with open(output_path, "w", newline="") as f:
            writer = csv.writer(f)

            writer.writerow([
                "step",
                "time",
                "route_name",
                "spawn_index",
                "controller_type",
                "tuning_value",
                "x",
                "y",
                "yaw_deg",
                "steer",
                "throttle",
                "brake",
                "cross_track_error",
                "heading_error_deg",
                "closest_waypoint",
                "target_waypoint",
                "speed",
                "distance_to_goal"
            ])

            writer.writerows(log)

        print(f"Saved: {output_path}")

    finally:
        if vehicle is not None:
            vehicle.apply_control(
                carla.VehicleControl(
                    throttle=0.0,
                    brake=1.0
                )
            )

            world.tick()
            vehicle.destroy()
            world.tick()

        time.sleep(0.5)


# ============================================================
# FULL EXPERIMENT SWEEP
# ============================================================

def run_all_experiments():
    os.makedirs(RESULTS_FOLDER, exist_ok=True)

    client = carla.Client("localhost", 2000)
    client.set_timeout(30.0)

    print(f"Loading map: {MAP_NAME}")
    world = client.load_world(MAP_NAME)

    original_settings = world.get_settings()

    settings = world.get_settings()
    settings.synchronous_mode = True
    settings.fixed_delta_seconds = FIXED_DELTA_SECONDS
    world.apply_settings(settings)

    try:
        carla_map = world.get_map()
        blueprint_library = world.get_blueprint_library()

        resolved_routes = []

        print("\nResolving automatic route selections...")

        for route in ROUTES:
            actual_spawn_index = resolve_spawn_index(
                carla_map,
                route["spawn_index"]
            )

            resolved_routes.append({
                "name": route["name"],
                "spawn_index": actual_spawn_index
            })

        print("\nFinal routes selected:")
        for route in resolved_routes:
            print(
                f"  {route['name']} -> spawn index {route['spawn_index']}"
            )

        for route in resolved_routes:
            route_name = route["name"]
            spawn_index = route["spawn_index"]

            for k in STANLEY_GAINS:
                run_single_experiment(
                    world=world,
                    carla_map=carla_map,
                    blueprint_library=blueprint_library,
                    route_name=route_name,
                    spawn_index=spawn_index,
                    controller_type="stanley",
                    tuning_value=k
                )

            for lookahead in PURE_PURSUIT_LOOKAHEADS:
                run_single_experiment(
                    world=world,
                    carla_map=carla_map,
                    blueprint_library=blueprint_library,
                    route_name=route_name,
                    spawn_index=spawn_index,
                    controller_type="pure_pursuit",
                    tuning_value=lookahead
                )

        print("\nAll experiments complete.")
        print(f"CSV files saved in folder: {RESULTS_FOLDER}")

    finally:
        world.apply_settings(original_settings)


# ============================================================
# SCRIPT ENTRY POINT
# ============================================================

if __name__ == "__main__":
    run_all_experiments()