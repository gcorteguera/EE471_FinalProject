import pandas as pd
import matplotlib.pyplot as plt
import os

# ==============================================================
# Plotting and Analysis of Controller Performance
# ==============================================================

# CSV files to compare
FILES = {
    "Stanley k=0.8": "stanley_results.csv",
    "Pure Pursuit Ld=6m": "pure_pursuit_results.csv",
}


# Load CSV and convert simulation steps to time
def load_data(filename):

    if not os.path.exists(filename):
        print(f"Missing file: {filename}")
        return None

    df = pd.read_csv(filename)
    df["time"] = df["step"] * 0.05

    return df


# Plot cross-track error over time
def plot_cross_track_error(data):

    plt.figure()

    for label, df in data.items():
        plt.plot(df["time"], abs(df["cross_track_error"]), label=label)

    plt.xlabel("Time [s]")
    plt.ylabel("Absolute Cross-Track Error [m]")
    plt.title("Cross-Track Error Comparison")

    plt.legend()
    plt.grid(True)

    plt.tight_layout()
    plt.savefig("cross_track_error_comparison.png", dpi=300)

    plt.show()


# Plot heading error over time
def plot_heading_error(data):

    plt.figure()

    for label, df in data.items():
        plt.plot(df["time"], abs(df["heading_error_deg"]), label=label)

    plt.xlabel("Time [s]")
    plt.ylabel("Absolute Heading Error [deg]")
    plt.title("Heading Error Comparison")

    plt.legend()
    plt.grid(True)

    plt.tight_layout()
    plt.savefig("heading_error_comparison.png", dpi=300)

    plt.show()


# Plot vehicle trajectories
def plot_trajectory(data):

    plt.figure()

    for label, df in data.items():
        plt.plot(df["x"], df["y"], label=label)

    plt.xlabel("X Position [m]")
    plt.ylabel("Y Position [m]")
    plt.title("Vehicle Trajectory Comparison")

    plt.axis("equal")

    plt.legend()
    plt.grid(True)

    plt.tight_layout()
    plt.savefig("trajectory_comparison.png", dpi=300)

    plt.show()


# Create summary table of performance metrics
def make_summary_table(data):

    rows = []

    for label, df in data.items():

        rows.append({
            "Controller": label,
            "Mean |CTE| [m]": abs(df["cross_track_error"]).mean(),
            "Max |CTE| [m]": abs(df["cross_track_error"]).max(),
            "Mean |Heading Error| [deg]": abs(df["heading_error_deg"]).mean(),
            "Max |Heading Error| [deg]": abs(df["heading_error_deg"]).max(),
            "Final Distance to Goal [m]": df["distance_to_goal"].iloc[-1],
            "Simulation Time [s]": df["time"].iloc[-1],
        })

    summary = pd.DataFrame(rows)

    summary.to_csv(
        "summary_metrics.csv",
        index=False
    )

    print("\nSummary Metrics:")
    print(summary.to_string(index=False))


# Main program
def main():

    data = {}

    for label, filename in FILES.items():
        df = load_data(filename)
        if df is not None:
            data[label] = df
    if not data:
        print("No data loaded.")
        return

    plot_cross_track_error(data)
    plot_heading_error(data)
    plot_trajectory(data)
    make_summary_table(data)

    print("\nSaved plots:")
    print("cross_track_error_comparison.png")
    print("heading_error_comparison.png")
    print("trajectory_comparison.png")
    print("summary_metrics.csv")


if __name__ == "__main__":
    main()